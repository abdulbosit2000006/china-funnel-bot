{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "china-funnel-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Every minute: follow-ups (Phase 3) and housekeeping.
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "china-funnel-bot-db",
      "database_id": "aa89ad6e-3b7a-4419-867f-8236b2cd765e",
      "migrations_dir": "migrations"
    }
  ],
  // Lead magnet PDFs and images (create the bucket once: docs/setup-cloudflare.md, step 3b).
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "china-funnel-files" }],
  // Headless Chromium for HTML -> PDF (Free plan: 10 browser-minutes per day).
  "browser": { "binding": "BROWSER" },
  "vars": {
    "TIMEZONE": "Asia/Tashkent",
    // AI research model (OpenAI Responses API with web search).
    "OPENAI_MODEL": "gpt-6.1-sol",
    "OPENAI_TRANSCRIBE_MODEL": "gpt-4o-mini-transcribe"
  }
  // Secrets (never in git): TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET, ADMIN_API_TOKEN, ADMIN_TG_IDS, OPENAI_API_KEY
}
